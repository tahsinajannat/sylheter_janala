# Browser -> API (public, baked into the client bundle at build time)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Server (SSR) -> API. Inside docker compose this is the service name.
API_INTERNAL_URL=http://localhost:4000/api
# Public URL of this site (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
