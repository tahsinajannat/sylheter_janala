# Used by docker-compose. Copy to `.env` and edit.

# --- Postgres ---
POSTGRES_USER=sylheter
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sylheter_janala
DB_PORT=5432
API_PORT=4000

# --- API ---
# 32+ random characters:  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000        # frontend URL (used in email links)
API_URL=http://localhost:4000        # public API URL (used in unsubscribe headers)
SITE_TIMEZONE=Asia/Dhaka

# --- Cloudinary (image uploads, max 10 MB) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (any SMTP: Resend, Brevo, Amazon SES, Gmail app password...) ---
# Leave SMTP_HOST empty in development: emails are printed to the API log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="সিলেটের জানালা <no-reply@example.com>"
# Shared secret for POST /api/webhooks/email (bounce / complaint events)
EMAIL_WEBHOOK_SECRET=

# --- First admin account (created by `npm run seed`) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@sylheterjanala.local
ADMIN_PASSWORD=

# ---- Frontend (docker-compose.prod.yml) ----
# Public URL of the API as the BROWSER reaches it (built into the JS bundle)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
