{
  "name": "sylheter-janala-backend",
  "version": "1.0.0",
  "description": "API for সিলেটের জানালা (Sylheter Janala) news portal - Express + pg, no ORM",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js up",
    "migrate:status": "node src/db/migrate.js status",
    "migrate:create": "node src/db/migrate.js create",
    "db:reset": "node src/db/migrate.js reset",
    "seed": "node src/db/seed.js",
    "seed:demo": "node src/db/seed.js --demo",
    "test": "node --test tests/*.test.js",
    "docs:validate": "node scripts/validate-openapi.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "sanitize-html": "^2.18.1",
    "swagger-ui-dist": "^5.33.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0"
  }
}
