# For running the API directly with `npm run dev` (without Docker).
# Copy to `.env`.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://sylheter:change-me@localhost:5432/sylheter_janala
DB_SSL=false
RUN_MIGRATIONS_ON_START=true
# Swagger UI at /api/docs (default: on in development, off in production)
API_DOCS_ENABLED=true

# 32+ random characters:  openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string-of-32-chars-or-more
JWT_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
SITE_TIMEZONE=Asia/Dhaka

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="সিলেটের জানালা <no-reply@example.com>"
EMAIL_WEBHOOK_SECRET=

ADMIN_NAME=Admin
ADMIN_EMAIL=admin@sylheterjanala.local
ADMIN_PASSWORD=
